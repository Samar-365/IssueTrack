# Flask Environment
FLASK_ENV=development
PORT=5005
SECRET_KEY=issue-tracker-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database Configuration (leave blank for default SQLite in development)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/issue_tracker

# GitHub Webhooks Configuration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_DEFAULT_BRANCH=main
GITHUB_AUTO_CLOSE_ENABLED=true
